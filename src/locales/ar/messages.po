#. placeholder {0}: PENDING_INVITES.length
#: src/App.tsx:185
msgid "{0, plural, =0 {Nobody has been invited yet, so there is nobody to remind.} one {# person has not accepted their invitation yet, so you may want to send them a reminder.} other {# people have not accepted their invitations yet, so you may want to send them a reminder.}}"
msgstr "{0, plural, =0 {لم تتم دعوة أحد بعد، لذا لا يوجد أحد لإرسال تذكير إليه.} zero {لم تتم دعوة أحد بعد، لذا لا يوجد أحد لإرسال تذكير إليه.} one {لم يقبل شخص واحد (#) دعوته بعد، لذا قد ترغب في إرسال تذكير إليه.} two {لم يقبل المدعوان (#) دعوتهما بعد، لذا قد ترغب في إرسال تذكير إليهما.} few {لم يقبل # أشخاص دعواتهم بعد، لذا قد ترغب في إرسال تذكير إليهم.} many {لم يقبل # شخصًا دعواتهم بعد، لذا قد ترغب في إرسال تذكير إليهم.} other {لم يقبل # شخص دعواتهم بعد، لذا قد ترغب في إرسال تذكير إليهم.}}"

